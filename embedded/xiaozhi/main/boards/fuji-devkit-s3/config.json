{
    "target": "esp32s3",
    "builds": [
        {
            "name": "fuji-devkit-s3",
            "idf_version": "==6.0.2",
            "sdkconfig_append": [
                "CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y",
                "CONFIG_SPIRAM=y",
                "CONFIG_SPIRAM_MODE_OCT=y"
            ]
        },
        {
            "name": "fuji-devkit-s3-probe",
            "idf_version": "==6.0.2",
            "sdkconfig_append": [
                "CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y",
                "CONFIG_SPIRAM=y",
                "CONFIG_SPIRAM_MODE_OCT=y",
                "CONFIG_SPIRAM_IGNORE_NOTFOUND=y",
                "CONFIG_BOARD_PROBE_ONLY=y"
            ]
        },
        {
            "name": "fuji-devkit-s3-display-test",
            "idf_version": "==6.0.2",
            "sdkconfig_append": [
                "CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y",
                "CONFIG_SPIRAM=y",
                "CONFIG_SPIRAM_MODE_OCT=y",
                "CONFIG_BOARD_DISPLAY_TEST_ONLY=y"
            ]
        },
        {
            "name": "fuji-devkit-s3-oled-test",
            "idf_version": "==6.0.2",
            "sdkconfig_append": [
                "CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y",
                "CONFIG_SPIRAM=y",
                "CONFIG_SPIRAM_MODE_OCT=y",
                "CONFIG_BOARD_OLED_TEST_ONLY=y"
            ]
        },
        {
            "name": "fuji-devkit-s3-mic-test",
            "idf_version": "==6.0.2",
            "sdkconfig_append": [
                "CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y",
                "CONFIG_SPIRAM=y",
                "CONFIG_SPIRAM_MODE_OCT=y",
                "CONFIG_BOARD_MIC_TEST_ONLY=y"
            ]
        },
        {
            "name": "fuji-devkit-s3-self-test",
            "idf_version": "==6.0.2",
            "sdkconfig_append": [
                "CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y",
                "CONFIG_SPIRAM=y",
                "CONFIG_SPIRAM_MODE_OCT=y",
                "CONFIG_BOARD_HARDWARE_SELF_TEST=y"
            ]
        }
    ]
