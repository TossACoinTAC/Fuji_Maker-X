{
    "target": "esp32s3",
    "builds": [
        {
            "name": "fuji-waveshare-1p46",
            "idf_version": "==6.0.2",
            "sdkconfig_append": [
                "CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y",
                "CONFIG_SPIRAM=y",
                "CONFIG_SPIRAM_MODE_OCT=y",
                "CONFIG_FUJI_BLE_TRANSPORT=y",
                "CONFIG_BT_ENABLED=y",
                "CONFIG_BT_NIMBLE_ENABLED=y",
                "CONFIG_BT_CONTROLLER_ENABLED=y",
                "CONFIG_BT_NIMBLE_ROLE_CENTRAL=n",
                "CONFIG_BT_NIMBLE_ROLE_OBSERVER=n",
                "CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y",
                "CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y",
                "CONFIG_BT_NIMBLE_GATT_SERVER=y",
                "CONFIG_BT_NIMBLE_SECURITY_ENABLE=y",
                "CONFIG_BT_NIMBLE_SM_LEGACY=n",
                "CONFIG_BT_NIMBLE_SM_SC=y",
                "CONFIG_BT_NIMBLE_SM_SC_ONLY=1",
                "CONFIG_BT_NIMBLE_SM_LVL=3",
                "CONFIG_BT_NIMBLE_NVS_PERSIST=y",
                "CONFIG_BT_NIMBLE_MAX_BONDS=2",
                "CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1"
            ]
        },
        {
            "name": "fuji-waveshare-1p46-probe",
            "idf_version": "==6.0.2",
            "sdkconfig_append": [
                "CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y",
                "CONFIG_SPIRAM=y",
                "CONFIG_SPIRAM_MODE_OCT=y",
                "CONFIG_SPIRAM_IGNORE_NOTFOUND=y",
                "CONFIG_BOARD_PROBE_ONLY=y"
            ]
        },
        {
            "name": "fuji-waveshare-1p46-display-test",
            "idf_version": "==6.0.2",
            "sdkconfig_append": [
                "CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y",
                "CONFIG_SPIRAM=y",
                "CONFIG_SPIRAM_MODE_OCT=y",
                "CONFIG_BOARD_DISPLAY_TEST_ONLY=y"
            ]
        },
        {
            "name": "fuji-waveshare-1p46-mic-test",
            "idf_version": "==6.0.2",
            "sdkconfig_append": [
                "CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y",
                "CONFIG_SPIRAM=y",
                "CONFIG_SPIRAM_MODE_OCT=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v2/16m_mic_capture.csv\"",
                "CONFIG_BOARD_MIC_TEST_ONLY=y"
            ]
        },
        {
            "name": "fuji-waveshare-1p46-speaker-test",
            "idf_version": "==6.0.2",
            "sdkconfig_append": [
                "CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y",
                "CONFIG_SPIRAM=y",
                "CONFIG_SPIRAM_MODE_OCT=y",
                "CONFIG_BOARD_SPEAKER_TEST_ONLY=y"
            ]
        }
    ]
}
